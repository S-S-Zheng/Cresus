# Connexion directe Postgres (Supabase -> Project Settings -> Database ->
# Connection string -> URI). Utilisée par asyncpg pour les requêtes SQL/pgvector.
SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Clés API
MISTRAL_API_KEY=""

HUGGINGFACE_TOKEN=""
HUGGINGFACE_USERNAME=""
HUGGINGFACE_SPACE_NAME=""

SUPABASE_ANON_KEY=""

# Logfire (logfire.pydantic.dev) -- optionnel en local, requis en prod
LOGFIRE_TOKEN=""

